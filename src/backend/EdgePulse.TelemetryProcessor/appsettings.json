{
  "ConnectionStrings": {
    "RabbitMQ": "amqp://edgepulse:<SET-VIA-USER-SECRETS-OR-ENV>@localhost:5672/edgepulse",
    "MongoDB": "mongodb://edgepulse:<SET-VIA-USER-SECRETS-OR-ENV>@localhost:27017",
    "SqlServer": "Server=localhost,1433;Database=EdgePulse;User Id=sa;Password=<SET-VIA-USER-SECRETS-OR-ENV>;TrustServerCertificate=True"
  },
  "MongoDB": {
    "Database": "edgepulse_telemetry"
  },
  "AlertEngine": {
    "ThresholdCacheRefreshSeconds": 60
  },
  "Smtp": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "User": "",
    "Password": "",
    "From": "alerts@edgepulse.local",
    "Recipients": [
      "operations@nordpulp.example"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "WorkOrders": {
    "AutoCreateFromAlerts": true,
    "AutoCreateSeverities": [
      "CRITICAL",
      "HIGH"
    ]
  }
}
