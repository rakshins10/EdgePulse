# EdgePulse Ingestion Service — environment variables
# Copy to .env and adjust for your environment

# Port for this service to listen on
PORT=3000

# URL of the EdgePulse .NET API (used for device key validation)
EDGEPULSE_API_URL=http://localhost:5104

# Shared secret for service-to-service authentication (must match appsettings.json)
SERVICE_KEY=ingestion-service-dev-key-change-before-deploy

# RabbitMQ connection string
# Format: amqp://<user>:<password>@<host>:<port>/<vhost>
RABBITMQ_URL=amqp://edgepulse:EdgePulse%402026@localhost:5672/edgepulse
