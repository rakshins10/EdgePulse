{
  "name": "edgepulse-opcua-agent",
  "version": "0.1.0",
  "description": "OPC-UA to RabbitMQ edge agent for EdgePulse IIoT Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "simulate": "node dist/index.js --simulate",
    "dev": "ts-node src/index.ts",
    "dev:simulate": "ts-node src/index.ts --simulate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "node-opcua": "^2.119.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
